# Django
DJANGO_SETTINGS_MODULE=skylinx.settings
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=*

# Database (used by compose to form DATABASE_URL)
POSTGRES_DB=skylinx
POSTGRES_USER=skylinx
POSTGRES_PASSWORD=skylinx

# Optional: storage/other
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=

# Redis Cache
REDIS_PASSWORD=skylinx
REDIS_URL=redis://:skylinx@redis:6379/0

# Licensing
# client = a deployed customer HRMS (enforces plan/features/employee cap/expiry)
# server = the vendor's private instance (all features on; manages Plans/Licenses)
LICENSE_ROLE=client
# Where client instances verify their key (leave blank on the server instance)
LICENSE_SERVER_URL=
